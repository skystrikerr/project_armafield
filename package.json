{
  "name": "claudefield",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Claudefield \u2014 a low-poly WWII combined-arms battle in the browser: infantry, tanks and aircraft over three capture points.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "electron": "electron .",
    "electron:dev": "CLAUDEFIELD_DEV_URL=http://localhost:5173 electron .",
    "dist:win": "npm run build && electron-builder --win portable --publish=never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish=never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish=never"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^5.4.19"
  },
  "build": {
    "appId": "com.skystrikerr.claudefield",
    "productName": "Claudefield",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Claudefield-${version}-windows.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "Claudefield-${version}-linux.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "Claudefield-${version}-mac-${arch}.${ext}"
    }
  },
  "license": "MIT",
  "author": "skystrikerr",
  "homepage": "https://skystrikerr.github.io/project_armafield/",
  "repository": {
    "type": "git",
    "url": "https://github.com/skystrikerr/project_armafield.git"
  }
}
