{
  "name": "projectblackmirror",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Thronglets \u2014 an autonomous three.js voxel colony",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "electron": "electron .",
    "electron:dev": "THRONGLETS_DEV_URL=http://localhost:5173 electron .",
    "electron:claudefield": "electron electron/claudefield-main.cjs",
    "electron:claudefield:dev": "CLAUDEFIELD_DEV_URL=http://localhost:5173/ironfront.html electron electron/claudefield-main.cjs",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:win": "npm run build && electron-builder --win portable --publish=never",
    "dist:claudefield:win": "npm run build && electron-builder --win portable --publish=never --config electron-builder.claudefield.json",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish=never",
    "dist:claudefield:linux": "npm run build && electron-builder --linux AppImage --publish=never --config electron-builder.claudefield.json",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:claudefield:mac": "npm run build && electron-builder --mac --publish=never --config electron-builder.claudefield.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^5.4.19"
  },
  "build": {
    "appId": "com.skystrikerr.thronglets",
    "productName": "Thronglets",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Thronglets-${version}-win.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "Thronglets-${version}-linux.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "Thronglets-${version}-mac.${ext}"
    }
  }
}
